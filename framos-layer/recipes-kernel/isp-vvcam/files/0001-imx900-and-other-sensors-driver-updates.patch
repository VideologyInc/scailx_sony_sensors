-	if (which_control == 0) { // from ISP driver
-		integration_time_line = ((exp >> 10)
-		   * IMX662_K_FACTOR) / sensor->cur_mode.ae_info.one_line_exp_time_ns;
-	} else {  // from V4L2 control
+//	if (which_control == 0) { // from ISP driver
+//		integration_time_line = ((exp >> 10)
+//		   * IMX662_K_FACTOR) / sensor->cur_mode.ae_info.one_line_exp_time_ns;
